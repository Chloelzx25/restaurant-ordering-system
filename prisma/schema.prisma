generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model feedback {
  feedbackId       Int                @id @default(autoincrement()) @map("feedback_id")
  memberId         Int                @map("member_id")
  productId        Int                @map("product_id")
  saleOrderId      Int                @map("sale_order_id")
  rating           Int                @db.SmallInt
  comment          String
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime?          @default(now()) @map("updated_at") @db.Timestamp(6)
  member           member             @relation(fields: [memberId], references: [memberId], onDelete: NoAction, onUpdate: NoAction)
  product          product            @relation(fields: [productId], references: [productId], onDelete: NoAction, onUpdate: NoAction)
  saleOrder        saleOrder          @relation(fields: [saleOrderId], references: [orderId], onDelete: NoAction, onUpdate: NoAction)
  feedbackResponse feedbackResponse[]

  @@unique([memberId, productId, saleOrderId])
}

model feedbackResponse {
  responseId Int      @id @default(autoincrement()) @map("response_id")
  feedbackId Int      @map("feedback_id")
  memberId   Int      @map("member_id")
  comment    String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  feedback   feedback @relation(fields: [feedbackId], references: [feedbackId], onDelete: Cascade, onUpdate: NoAction)
  member     member   @relation(fields: [memberId], references: [memberId], onDelete: NoAction, onUpdate: NoAction)

  @@map("feedback_response")
}

model member {
  memberId         Int                @id @default(autoincrement()) @map("member_id")
  username         String             @unique @db.VarChar(50)
  email            String             @unique @db.VarChar(100)
  passwordHash     String             @map("password_hash") @db.VarChar(255)
  firstName        String             @map("first_name") @db.VarChar(50)
  lastName         String             @map("last_name") @db.VarChar(50)
  createdAt        DateTime?          @default(now()) @map("created_at") @db.Timestamp(6)
  feedback         feedback[]
  feedbackResponse feedbackResponse[]
  memberRole       memberRole[]
  saleOrder        saleOrder[]
  cart             cart?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model memberRole {
  memberId Int    @map("member_id")
  role     String @db.VarChar(20)
  member   member @relation(fields: [memberId], references: [memberId], onDelete: NoAction, onUpdate: NoAction)

  @@id([memberId, role])
  @@map("member_role")
}

model product {
  productId     Int             @id @default(autoincrement()) @map("product_id")
  name          String          @db.VarChar(100)
  description   String?
  price         Decimal         @db.Decimal(10, 2)
  category      String?         @db.VarChar(50)
  isAvailable   Boolean?        @default(true) @map("is_available")
  createdAt     DateTime?       @default(now()) @map("created_at") @db.Timestamp(6)
  feedback      feedback[]
  saleOrderItem saleOrderItem[]
  cartItems     cartItem[]

}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model saleOrder {
  orderId         Int             @id @default(autoincrement()) @map("order_id")
  memberId        Int?            @map("member_id")
  orderDate       DateTime?       @default(now()) @map("order_date") @db.Timestamp(6)
  totalAmount     Decimal         @map("total_amount") @db.Decimal(10, 2)
  status          String          @db.VarChar(20)
  deliveryAddress String?         @map("delivery_address")
  feedback        feedback[]
  member          member?         @relation(fields: [memberId], references: [memberId], onDelete: NoAction, onUpdate: NoAction)
  saleOrderItem   saleOrderItem[]

  @@map("sale_order")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model saleOrderItem {
  orderItemId Int        @id @default(autoincrement()) @map("order_item_id")
  orderId     Int?       @map("order_id")
  productId   Int?       @map("product_id")
  quantity    Int
  unitPrice   Decimal    @map("unit_price") @db.Decimal(10, 2)
  subtotal    Decimal    @db.Decimal(10, 2)
  saleOrder   saleOrder? @relation(fields: [orderId], references: [orderId], onDelete: NoAction, onUpdate: NoAction)
  product     product?   @relation(fields: [productId], references: [productId], onDelete: NoAction, onUpdate: NoAction)

  @@map("sale_order_item")
}

model cart {
 cartId    Int @id @default(autoincrement()) @map("cart_id")
 memberId  Int @unique @map("member_id")
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
 updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
 member    member @relation(fields: [memberId], references: [memberId], onDelete: Cascade, onUpdate: NoAction)
 cartItems cartItem[]
 
 @@map("cart")
}

model cartItem {
 cartItemId Int @id @default(autoincrement()) @map("cart_item_id")
 cartId     Int @map("cart_id")
 productId  Int @map("product_id")
 quantity   Int
 unitPrice  Decimal @map("unit_price") @db.Decimal(10, 2)
 cart       cart @relation(fields: [cartId], references: [cartId], onDelete: Cascade, onUpdate: NoAction)
 product    product @relation(fields: [productId], references: [productId], onDelete: NoAction, onUpdate: NoAction)
 
 @@unique([cartId, productId])
 @@map("cart_item")
}

model discount {
 discountId   Int @id @default(autoincrement()) @map("discount_id")
 type         String @db.VarChar(20)
 minQuantity  Int? @map("min_quantity")
 minCartValue Decimal? @map("min_cart_value") @db.Decimal(10, 2)
 percentage   Decimal @db.Decimal(5, 2)
 description  String
 isActive     Boolean @default(true) @map("is_active")
 
 @@map("discount")
}

model deliveryTier {
 tierId        Int @id @default(autoincrement()) @map("tier_id")
 minOrderValue Decimal @map("min_order_value") @db.Decimal(10, 2)
 deliveryFee   Decimal @map("delivery_fee") @db.Decimal(10, 2)
 description   String
 
 @@map("delivery_tier")
}

